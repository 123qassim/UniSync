{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/brainmate/connections/request",
      "destination": "/api/brainmate-connections-request"
    },
    {
      "source": "/api/brainmate/groups/:groupId/join",
      "destination": "/api/brainmate-group-join?groupId=:groupId"
    },
    {
      "source": "/api/brainmate/groups",
      "destination": "/api/brainmate-groups"
    },
    {
      "source": "/api/brainmate/sessions",
      "destination": "/api/brainmate-sessions"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
